{
  "name": "podapple",
  "version": "0.2.0",
  "description": "A modern, terminal-based Apple Podcasts synchronizer built for speed and simplicity.",
  "bin": {
    "podapple": "./src/index.tsx"
  },
  "engines": {
    "bun": ">=1.0.0"
  },
  "module": "src/index.tsx",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun run --watch src/index.tsx",
    "test": "bun test src/__tests__",
    "lint": "biome check .",
    "format": "biome check --write .",
    "build": "bun scripts/build.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.9",
    "@effect/language-service": "^0.85.1",
    "@types/bun": "^1.3.11"
  },
  "peerDependencies": {
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@effect/schema": "^0.75.5",
    "@opentui/core": "^0.1.92",
    "@opentui/solid": "^0.1.92",
    "effect": "^3.21.0",
    "node-id3": "^0.2.9",
    "solid-js": "^1.9.12"
  },
  "optionalDependencies": {
    "@opentui/core-darwin-arm64": "^0.1.92",
    "@opentui/core-darwin-x64": "^0.1.92"
  }
}
