		"lint": "oxlint .",
		"format": "oxfmt .",
		"build": "bun scripts/build.ts"
	},
	"dependencies": {
		"@effect/schema": "^0.75.5",
		"@opentui/core": "^0.5.8",
		"@opentui/solid": "^0.5.8",
