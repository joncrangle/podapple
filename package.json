		"node-id3": "^0.2.9",
		"solid-js": "^1.9.15"
	},
	"devDependencies": {
		"@effect/language-service": "^0.87.2",
		"@types/bun": "^1.4.0",
		"oxfmt": "^0.66.0",
		"oxlint": "^1.80.0"
	},
	"peerDependencies": {
		"typescript": "^6.0.3"
	},
	"optionalDependencies": {
		"@opentui/core-darwin-arm64": "^0.5.8",
		"@opentui/core-darwin-x64": "^0.5.8"
