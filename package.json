		"node-id3": "^0.2.9",
		"solid-js": "^1.9.13"
	},
	"devDependencies": {
		"@effect/language-service": "^0.86.2",
		"@types/bun": "^1.3.14",
		"oxfmt": "^0.52.0",
		"oxlint": "^1.66.0"
	},
	"peerDependencies": {
		"typescript": "^5.9.3"
	},
	"optionalDependencies": {
		"@opentui/core-darwin-arm64": "^0.2.15",
		"@opentui/core-darwin-x64": "^0.2.15"
