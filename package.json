{
	"name": "podapple",
	"version": "0.3.0",
	"description": "A modern, terminal-based Apple Podcasts synchronizer built for speed and simplicity.",
	"bin": {
		"podapple": "./src/index.tsx"
	},
	"type": "module",
	"scripts": {
		"dev": "bun run --watch src/index.tsx",
