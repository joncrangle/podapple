{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"title": "Podapple Configuration",
	"type": "object",
	"properties": {
		"$schema": {
			"type": "string"
		},
		"theme": {
			"type": "string",
			"enum": [
				"System",
				"Catppuccin",
				"Cyberdream",
				"Dracula",
				"Gruvbox",
				"Kanagawa",
				"Kanso",
				"Monokai",
				"Nord",
				"One Dark",
				"Rosé Pine",
				"Solarized Dark",
				"Tokyo Night",
				"Zenburn"
			],
			"description": "The color theme to use",
			"default": "Catppuccin"
		},
		"favoriteDrives": {
			"type": "array",
			"items": {
				"type": "string"
			},
			"description": "Ordered list of favorite drive names (highest priority first)",
			"default": []
		}
	}
}
